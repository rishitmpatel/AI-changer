{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-switch/chats.schema.json",
  "title": "ai-switch common chat-history format",
  "type": "object",
  "required": ["schema_version", "source_provider", "conversations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_provider": {"type": "string"},
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "messages"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "source_provider": {"type": "string"},
          "created": {"type": ["string", "null"]},
          "updated": {"type": ["string", "null"]},
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "text"],
              "properties": {
                "role": {"enum": ["user", "assistant", "system"]},
                "text": {"type": "string"},
                "time": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
